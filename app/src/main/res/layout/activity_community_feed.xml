<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- Screen Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMMUNITY INSPIRATION (FIRESTORE)"
        android:textColor="@color/purple_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kindred Minds 💬🌱"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Real social support without comparison or filters."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <!-- Create Post Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_white"
        android:padding="14dp"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/et_new_post_content"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#FAF8FD"
            android:hint="Share a tiny step or encouraging thought..."
            android:gravity="top|start"
            android:padding="10dp"
            android:textSize="14sp"
            android:inputType="textMultiLine|textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <Spinner
                android:id="@+id/spinner_post_tag"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#F0EBF8" />

            <Button
                android:id="@+id/btn_submit_post"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/purple_primary"
                android:text="Share Post"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_empty_feed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No community posts yet. Be the first to share a positive thought! 🌱"
        android:gravity="center"
        android:padding="30dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- RecyclerView for Social Feed -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_community_feed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

</LinearLayout>
