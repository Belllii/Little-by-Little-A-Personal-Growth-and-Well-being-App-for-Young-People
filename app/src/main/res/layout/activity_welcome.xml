<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:src="@drawable/ic_avatar"
            android:contentDescription="LittleByLittle logo"
            android:layout_marginTop="70dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LittleByLittle"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#7655A6"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A little progress, every day."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#57427D"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your space to grow, reflect and build confidence — one step at a time."
            android:textSize="15sp"
            android:textColor="#777777"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="45dp"/>

        <Button
            android:id="@+id/btnWelcomeLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Login"/>

        <Button
            android:id="@+id/btnWelcomeRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Create Account"
            android:layout_marginTop="15dp"/>

    </LinearLayout>
</ScrollView>
