<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/welcome_flower"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="LittleByLittle welcome flower"
            android:layout_marginTop="35dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LittleByLittle"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#7655A6"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A little progress, every day."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#57427D"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your space to grow, reflect and build confidence — one step at a time."
            android:textSize="15sp"
            android:textColor="#777777"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="45dp"/>

        <!-- Google Sign-In Button on Welcome -->
        <LinearLayout
            android:id="@+id/btnWelcomeGoogle"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_google_button"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_google_logo"
                android:contentDescription="Google Logo"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue with Google"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3C4043"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnWelcomeLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Login with Email"/>

        <Button
            android:id="@+id/btnWelcomeRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Create Account"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
