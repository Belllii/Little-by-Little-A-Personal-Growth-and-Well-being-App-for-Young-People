<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tv_item_mood_emoji"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="🌱"
        android:textSize="26sp"
        android:background="#F3EEFA" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tv_item_mood_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feeling Calm"
            android:textColor="#49356D"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_checkin_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07 Nov 2026, 04:30 PM"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_item_checkin_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Took a short walk outside."
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_delete_checkin"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Delete check-in"
        android:tint="#A07878" />

</LinearLayout>
