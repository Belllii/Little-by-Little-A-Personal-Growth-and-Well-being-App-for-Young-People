<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUPPORT CIRCLE (CONTENT PROVIDER)"
            android:textColor="@color/purple_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="My Trusted Support Buddy 🤝"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="When social anxiety or life feels overwhelming, having one safe person to talk to makes a world of difference. Choose a trusted friend, family member, or mentor."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Selected Contact Card -->
        <LinearLayout
            android:id="@+id/card_contact_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tv_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Buddy Selected Yet"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_contact_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap below to select someone you trust from your contacts"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/layout_contact_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btn_call_buddy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/purple_primary"
                    android:text="Call Buddy 📞"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_sms_buddy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/purple_pill_bg"
                    android:text="Message 💬"
                    android:textAllCaps="false"
                    android:textColor="@color/purple_primary" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_pick_contact"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/purple_primary"
            android:text="Choose from Contacts (Content Provider)"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_permission_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Requires Contacts permission to safely pick a trusted buddy."
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
