<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- Profile Avatar (Firebase Storage & Media Content Provider) -->
        <ImageView
            android:id="@+id/ivProfileAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_avatar"
            android:contentDescription="Profile avatar"
            android:layout_marginTop="30dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvChangePhotoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap avatar to upload photo (Firebase Storage)"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"
            android:layout_marginTop="6dp" />

        <!-- Profile Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#57427D"
            android:layout_marginTop="16dp" />

        <!-- User Name -->
        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#57427D"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <!-- User Email -->
        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email address"
            android:textSize="15sp"
            android:textColor="#555555"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="4dp" />

        <!-- Edit Name -->
        <EditText
            android:id="@+id/etEditName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your new name"
            android:padding="12dp"
            android:singleLine="true"
            android:inputType="textPersonName"
            android:layout_marginTop="16dp"
            android:background="@android:drawable/edit_text" />

        <!-- Update Name Button -->
        <Button
            android:id="@+id/btnUpdateName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Update Name"
            android:layout_marginTop="10dp" />

        <!-- Support Buddy (Content Provider) Button -->
        <Button
            android:id="@+id/btnOpenSupportBuddy"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#EDE7F6"
            android:textColor="@color/purple_primary"
            android:text="Support Circle: Trusted Buddy 🤝"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />

        <!-- Test REST API POST Button -->
        <Button
            android:id="@+id/btnTestRestApi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#EDE7F6"
            android:textColor="@color/purple_primary"
            android:text="Test REST API (HTTP POST) 🌐"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#D32F2F"
            android:text="Logout"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
