<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white">

    <!-- Header: Author Name & Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_post_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alex M."
            android:textColor="#49356D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_post_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#SocialWin"
            android:textSize="12sp"
            android:textColor="@color/purple_primary"
            android:background="#EDE7F6"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_post_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Just now"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <!-- Message Body -->
    <TextView
        android:id="@+id/tv_post_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="I said hi to my seatmate in class today! My hands were shaking at first, but they smiled back and we talked for 2 minutes. Small steps matter!"
        android:textColor="#333333"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <!-- Action Bar: Like & Share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_like_post"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#F8EEFA"
            android:text="💜 0 Likes"
            android:textAllCaps="false"
            android:textColor="@color/purple_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_share_post"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F3F0F7"
            android:text="Share 📤"
            android:textAllCaps="false"
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
