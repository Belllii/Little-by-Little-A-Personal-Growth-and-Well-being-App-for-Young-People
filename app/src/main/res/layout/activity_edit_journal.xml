<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EDIT REFLECTION"
        android:textColor="@color/purple_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_edit_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved on 07 Nov 2026"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/et_edit_content"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:background="@color/card_surface"
        android:gravity="top|start"
        android:hint="Edit your reflection..."
        android:inputType="textMultiLine|textCapSentences"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_update_journal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/purple_primary"
        android:text="Save Changes (Update)"
        android:textAllCaps="false"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btn_share_edit_journal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#EDE7F6"
        android:text="Share Reflection 📤"
        android:textAllCaps="false"
        android:textColor="@color/purple_primary" />

</LinearLayout>
