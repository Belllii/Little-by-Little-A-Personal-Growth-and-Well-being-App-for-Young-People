<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THOUGHT &amp; REFLECTION"
            android:textColor="@color/purple_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="A little space for your thoughts 🌱"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Write freely. You don't need perfect words, and you don't have to share your thoughts with anyone."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Guided Reflection Prompt (XML)"
            android:textColor="@color/purple_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_guided_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_prompt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Being Gentle With Yourself"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_prompt_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is something you struggled with today that you can forgive yourself for?"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_next_prompt"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="New Prompt 🔄"
                android:textSize="12sp"
                android:backgroundTint="@color/purple_pill_bg"
                android:textColor="@color/purple_primary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Today's reflection"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_journal_entry"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:background="@color/card_surface"
            android:gravity="top|start"
            android:hint="What's on your mind today?"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_save_journal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="54dp"
            android:backgroundTint="@color/purple_primary"
            android:text="Save Reflection"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_share_journal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#EDE7F6"
            android:text="Share Reflection 📤"
            android:textAllCaps="false"
            android:textColor="@color/purple_primary" />

        <TextView
            android:id="@+id/tv_journal_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/teal_accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_view_journal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/purple_pill_bg"
            android:text="View Previous Entries"
            android:textAllCaps="false"
            android:textColor="@color/purple_primary" />

    </LinearLayout>

</ScrollView>
