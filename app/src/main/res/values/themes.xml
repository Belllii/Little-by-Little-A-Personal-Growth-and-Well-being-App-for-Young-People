<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with NoActionBar for clean modern UI -->
    <style name="Theme.LittleByLittle" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_gradient_start</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Background -->
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>