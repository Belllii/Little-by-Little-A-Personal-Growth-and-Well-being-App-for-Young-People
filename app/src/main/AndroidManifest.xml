<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.littlebylittle">

    <!-- Network Permissions for Firebase and REST APIs -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Content Provider: Contacts -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Service and Notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Content Provider: Media files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LittleByLittle"
        tools:targetApi="33">

        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CheckInActivity"
            android:exported="false" />
        <activity
            android:name=".CheckInHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".JournalHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".EditJournalActivity"
            android:exported="false" />
        <activity
            android:name=".TrustedContactActivity"
            android:exported="false" />
        <activity
            android:name=".CommunityFeedActivity"
            android:exported="false" />

        <!-- Mindful Calm Foreground and Bound Service -->
        <service
            android:name=".MindfulCalmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ForegroundServicePermission" />

        <!-- System Broadcast Receiver for Airplane Mode & Battery Status -->
        <receiver
            android:name=".SystemStatusReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>